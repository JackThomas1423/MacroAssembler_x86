%define PLUS  "+"
%define MINUS "-"
%define MULT  "*"
%define DIV   "/"

%define my_int [0-9]+

%type func: type(PLUS) | type(MINUS) | type(MULT) | type(DIV)

%macro insert_zero 0 0
    %literal
        %rotate 1
        %1 = 0 
    %endliteral
%endmacro

%macro equ 3 1
    %arg %1 : my_int
    %arg %2 : func
    %arg %3 : my_int

    %ref &1 : number

    %ensure %1 != %2

    %if %2 == PLUS
        &1 = %1 + %2
    %endif

    %if %2 == MINUS
        &1 = %1 - %2
    %endif

    %if %2 == MULT
        &1 = %1 * %2
    %endif

    %if %2 == DIV
        &1 = %1 / %2
    %endif

    %literal
        %rotate 2
    %endliteral
%endmacro

%macro solver 1-10 1
    %arg %1 : number | type(MINUS)
    %arg %2 : number | func
    %arg %3 : number | func
    %arg %4 : number | func

    ; - 1 + 3
    %if %1 == MINUS
        %use insert_zero
    %endif
    ; 0 - 1 + 3

    %rep %0 >= 3
        %use equ %1 %2 %3 %3
    %endrep

    %1
%endmacro

solver - 1 + 3 * 2